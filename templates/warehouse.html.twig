{% extends 'base.html.twig' %}

{% block title %}Warehouse Dashboard{% endblock %}

{% block body %}
<div class="dashboard-container">
    
    {% if is_granted('ROLE_ADMIN') %}
        <h2>Global Warehouse Overview</h2>
        <p class="subtitle">Real-time stock levels across all company facilities.</p>
    {% else %}
        <h2>Your Inventory</h2>
        <p class="subtitle">Current stock levels across your assigned warehouses.</p>
    {% endif %}

    {% for item in data %}
        <div class="simple-warehouse-card">
            <h3>{{ item.warehouse.name }}</h3>
            
            <ul class="stock-list">
                {% for product in item.stock %}
                    <li>
                        <span class="product-name">{{ product.productName }}</span>
                        <span class="stock-qty">
                            <strong>{{ product.totalStock }}</strong> {{ product.productUnit }}
                        </span>
                    </li>
                {% else %}
                    <li class="empty-stock">Empty (No items on stock)</li>
                {% endfor %}
            </ul>
        </div>
    {% else %}
        <div class="simple-warehouse-card">
            {% if is_granted('ROLE_ADMIN') %}
                <p class="empty-stock">No warehouses exist in the system yet.</p>
            {% else %}
                <p class="empty-stock">You are not assigned to any warehouses.</p>
            {% endif %}
        </div>
    {% endfor %}

</div>
{% endblock %}