{% extends 'base.html.twig' %}

{% block title %}Warehouse system{% endblock %}

{% block body %}
    <h1>Welcome, {{ app.user.userIdentifier }}!</h1>
    <p>Select an option from the menu above to get started.</p>

    <div style="background: #f4f4f4; padding: 15px; border-left: 4px solid #333;">
        <h3>Your permissions:</h3>
        <ul>
            {% if is_granted('ROLE_ADMIN') %}
                <li>You have full administrator privileges. You can manage the user and warehouse databases.</li>
            {% else %}
                <li>You are logged in as a staff member. You have access to your assigned warehouses.</li>
            {% endif %}
        </ul>
    </div>
{% endblock %}