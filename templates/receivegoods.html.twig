{% extends 'base.html.twig' %}

{% block title %}Receive Goods{% endblock %}

{% block body %}
<div class="form-container">
    <form class="magazyn-form" method="POST">
    {# Render the Symfony form #}
    {{ form_start(form, {'attr': {'class': 'magazyn-form'}}) }}
        
        <h2>Receive Goods</h2>
        <p class="subtitle">Enter delivery details to receive items.</p>

        {# Pick a warehouse #}
        <div class="form-group">
            {{ form_label(form.warehouse, 'Select Warehouse:') }}
            {{ form_widget(form.warehouse, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.warehouse) }}
        </div>

        {# Pick a product #}
        <div class="form-group">
            {{ form_label(form.product, 'Product:') }}
            {{ form_widget(form.product, {'attr': {
                'class': 'form-control',
                'onchange': 'updateUnitPreview(this)'
            }}) }}
            {{ form_errors(form.product) }}
        </div>

        {# Quantity received with dynamic unit suffix#}
        <div class="form-group">
            {{ form_label(form.quantity, 'Quantity Received:') }}
            <div class="input-group" id="quantity-group" data-suffix="">
                {{ form_widget(form.quantity, {'attr': {'class': 'form-control'}}) }}
            </div>
            {{ form_errors(form.quantity) }}
        </div>

        {# Unit price (net) #}
        <div class="form-group">
            {{ form_label(form.priceNetto, 'Unit Price (Net):') }}
            <div class="input-group" data-suffix="PLN">
                {{ form_widget(form.priceNetto, {'attr': {'class': 'form-control'}}) }}
            </div>
            {{ form_errors(form.priceNetto) }}
        </div>

        {# VAT #}
        <div class="form-group">
            {{ form_label(form.vat, 'VAT Rate (%):') }}
            <div class="input-group" data-suffix="%">
                {{ form_widget(form.vat, {'attr': {'class': 'form-control'}}) }}
            </div>
            {{ form_errors(form.vat) }}
        </div>

        {# Files #}
        <div class="form-group">
            <label for="files">Attach invoices (PDF/XML, max 4 files):</label>
            <input type="file" id="files" class="form-control-file" multiple accept=".pdf,.xml">
            <small class="form-help">Hold Ctrl/Cmd to select multiple files.</small>
        </div>

        <button type="submit" class="btn-submit">Confirm Receipt</button>

        {# Close the form #}
        {{ form_end(form) }}
        
        {# Loop through and display any success flash messages #}
        {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
        {% endfor %}
        
    </form>
</div>

<script>
    function updateUnitPreview(selectElement) {
        // 1. Get the selected option
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        
        // 2. Fetch its 'data-unit' value (fallback to empty string if none selected)
        const unit = selectedOption.getAttribute('data-unit') || '';
        
        // 3. Find the quantity input group container
        const quantityGroup = document.getElementById('quantity-group');
        
        // 4. Update its 'data-suffix' attribute dynamically!
        if (quantityGroup) {
            quantityGroup.setAttribute('data-suffix', unit);
        }
    }
</script>
{% endblock %}