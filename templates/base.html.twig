<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Warehouse system{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    </head>
    <body>

        <nav>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_warehouse') }}">Home</a>
                <a href="{{ path('app_receive_goods') }}">Receive Goods</a>
                <a href="{{ path('app_issue_goods') }}">Issue Goods</a>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <span style="color: #ffcc00; margin-right: 10px;">| Admin Panel:</span>
                <a href="{{ path('app_manage_warehouses') }}">Manage Warehouses</a>
                <a href="{{ path('app_manage_users') }}">Users</a>
                <a href="{{ path('app_manage_items') }}">Items</a>
            {% endif %}

            <<div class="user-info">
                {% if app.user %}
                    Logged in as: <strong>{{ app.user.userIdentifier }}</strong>
                <a href="{{ path('app_logout') }}" style="color: #ff4d4d; margin-left: 10px;">Log out</a>
            {% else %}
                <span style="color: #aaa;">Not logged in</span>
            {% endif %}
</div>
        </nav>

        <div class="container">
            {% block body %}{% endblock %}
        </div>

    </body>
</html>